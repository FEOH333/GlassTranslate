<Window x:Class="GlassTranslate.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Border CornerRadius="16" Margin="12" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2141822" Offset="0"/>
                <GradientStop Color="#F21B2230" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4DFFFFFF" Offset="0"/>
                <GradientStop Color="#2E7DD3FC" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="28" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="20,16,20,18" TextOptions.TextFormattingMode="Display">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" x:Name="Header" Background="Transparent" Margin="0,0,0,12">
                <TextBlock Text="⚙  API 与翻译设置" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMain}"/>
                <Button x:Name="BtnClose" Content="✕" Width="28" Height="28"
                        HorizontalAlignment="Right" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 提供商 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="服务商" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SegOpenAi" Style="{StaticResource SegRadio}" GroupName="Provider"
                                 Content="OpenAI" IsChecked="True"/>
                    <RadioButton x:Name="SegAnthropic" Style="{StaticResource SegRadio}" GroupName="Provider"
                                 Content="Anthropic"/>
                </StackPanel>
            </StackPanel>

            <!-- API Key -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="API Key" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="KeyBox" Grid.Column="0" Style="{StaticResource DarkPasswordBox}"/>
                    <TextBox x:Name="KeyPlain" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                             Visibility="Collapsed" IsReadOnly="False"/>
                    <Button x:Name="BtnEye" Grid.Column="1" Content="👁" Margin="8,0,0,0" Width="36"
                            FontSize="13" Cursor="Hand" ToolTip="显示/隐藏">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="9" Background="#1FFFFFFF" BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Base URL -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock x:Name="BaseUrlLabel" Text="API 地址（可改为中转/代理地址）" FontSize="12"
                           Foreground="{StaticResource TextSubtle}" Margin="0,0,0,6"/>
                <TextBox x:Name="BaseUrlBox" Style="{StaticResource DarkTextBox}"/>
            </StackPanel>

            <!-- 模型 -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="模型" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,6"/>
                <ComboBox x:Name="ModelBox" Style="{StaticResource DarkCombo}" IsEditable="True" Height="34"/>
            </StackPanel>

            <!-- 测试连接 -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnTest" Content="测试连接" Style="{StaticResource PillButton}" Width="110"/>
                <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSubtle}"
                           Width="290" Text=""/>
            </StackPanel>

            <!-- 缓存 & OCR -->
            <Grid Grid.Row="6" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CacheInfo" Text="本地缓存：0 条" FontSize="12"
                               Foreground="{StaticResource TextSubtle}"/>
                    <TextBlock x:Name="OcrInfo" Text="OCR 引擎：…" FontSize="12"
                               Foreground="{StaticResource TextSubtle}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="BtnClearCache" Grid.Column="1" Content="清空缓存"
                        Style="{StaticResource PillButton}" VerticalAlignment="Center"/>
            </Grid>

            <!-- 保存 -->
            <Button Grid.Row="7" x:Name="BtnSave" Content="保 存"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
