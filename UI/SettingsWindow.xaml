<Window x:Class="GlassTranslate.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="False"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Border CornerRadius="16" Margin="12" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2141822" Offset="0"/>
                <GradientStop Color="#F21B2230" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4DFFFFFF" Offset="0"/>
                <GradientStop Color="#2E7DD3FC" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="28" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="20,16,20,18" TextOptions.TextFormattingMode="Display">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" x:Name="Header" Background="Transparent" Margin="0,0,0,4">
                <TextBlock Text="⚙  设置 · 本地引擎（全程离线）" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMain}"/>
                <Button x:Name="BtnClose" Content="✕" Width="28" Height="28"
                        HorizontalAlignment="Right" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 引擎状态 -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="隐私说明：本软件不含任何联网代码，识别与翻译全部在本机完成。"
                           FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <TextBlock Text="翻译引擎" FontSize="12" Foreground="{StaticResource TextSubtle}" Margin="0,0,0,5"/>
                <Border CornerRadius="9" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF"
                        BorderThickness="1" Padding="12,8">
                    <TextBlock x:Name="MtInfo" Text="…" FontSize="13" Foreground="#FFD7E3F4"/>
                </Border>
                <TextBlock Text="OCR 引擎" FontSize="12" Foreground="{StaticResource TextSubtle}"
                           Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="9" Background="#1AFFFFFF"
                            BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="12,8">
                        <TextBlock x:Name="OcrInfo" Text="…" FontSize="13" Foreground="#FFD7E3F4"/>
                    </Border>
                    <ComboBox x:Name="EngineBox" Grid.Column="2" Width="120" Height="36"
                              FontSize="12.5" SelectedIndex="0">
                        <ComboBoxItem Content="自动"/>
                        <ComboBoxItem Content="RapidOCR"/>
                        <ComboBoxItem Content="Windows"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- 轮询间隔 -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="扫描间隔（画面静止时自动放缓）" FontSize="12"
                               Foreground="{StaticResource TextSubtle}"/>
                    <TextBlock x:Name="IntervalText" Grid.Column="1" FontSize="12"
                               Foreground="#FFD7E3F4" FontFamily="Consolas"/>
                </Grid>
                <Slider x:Name="IntervalSlider" Minimum="800" Maximum="3000" Interval="100"
                        VerticalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 缓存 & 用量 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CacheInfo" Text="本地句库：0 条" FontSize="12"
                               Foreground="{StaticResource TextSubtle}"/>
                    <TextBlock x:Name="UsageInfo" Text="" FontSize="12"
                               Foreground="{StaticResource TextSubtle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnClearCache" Grid.Column="1" Content="清空句库"
                        Style="{StaticResource PillButton}" VerticalAlignment="Center"/>
            </Grid>

            <!-- 保存 -->
            <Button Grid.Row="4" x:Name="BtnSave" Content="保 存"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,16,0,0"/>
        </Grid>
    </Border>
</Window>
