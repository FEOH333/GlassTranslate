<Window x:Class="GlassTranslate.UI.BallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Width="64" Height="64"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 主圆环：白→青→蓝紫 -->
        <LinearGradientBrush x:Key="RingBrush" StartPoint="0.05,0.05" EndPoint="0.95,0.95">
            <GradientStop Color="#F2FFFFFF" Offset="0"/>
            <GradientStop Color="#E7AFDBFF" Offset="0.35"/>
            <GradientStop Color="#E67DD3FC" Offset="0.65"/>
            <GradientStop Color="#F0A5B4FC" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GlassToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#FFF5F7FA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="10" Background="#16FFFFFF"
                                BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#FF94A3B8"
                                         Margin="0,1.5,9,1.5" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2BFFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="#FF4ADE80"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#667DD3FC"/>
                                <Setter TargetName="bd" Property="Background" Value="#2E7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF5F7FA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="#16FFFFFF"
                                BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2BFFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="BallMenu">
            <MenuItem x:Name="MenuHideBall" Header="隐藏悬浮球（托盘仍可用）"/>
            <Separator/>
            <MenuItem x:Name="MenuExit" Header="退出"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root">

        <!-- ============ 悬浮球（空心玻璃圆环） ============ -->
        <Grid x:Name="BallGlow" Width="52" Height="52"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BallScale"/>
            </Grid.RenderTransform>
            <!-- 外发光 -->
            <Grid.Effect>
                <DropShadowEffect Color="#FF8FD4FF" BlurRadius="13" ShadowDepth="0" Opacity="0.5"/>
            </Grid.Effect>

            <Grid x:Name="Ball" RenderTransformOrigin="0.5,0.5">
                <Grid.CacheMode><BitmapCache/></Grid.CacheMode>
                <Grid.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="7" ShadowDepth="1.5" Opacity="0.3"/>
                </Grid.Effect>

                <!-- 玻璃体：青→蓝紫渐变，半透明 -->
                <Ellipse>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.85,1">
                            <GradientStop Color="#59CFF7FF" Offset="0"/>
                            <GradientStop Color="#2F93C5FD" Offset="0.5"/>
                            <GradientStop Color="#3D8B93F8" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- 底部环境反光 -->
                <Ellipse>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.93" GradientOrigin="0.5,0.95"
                                             RadiusX="0.75" RadiusY="0.45">
                            <GradientStop Color="#3A7DD3FC" Offset="0"/>
                            <GradientStop Color="#007DD3FC" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- 左上高光（液态感） -->
                <Ellipse x:Name="Sheen" Opacity="0.62" Margin="10,7,16,23">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.32,0.28">
                            <GradientStop Color="#B4FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- 主圆环 -->
                <Ellipse Stroke="{StaticResource RingBrush}" StrokeThickness="2.4"/>
                <!-- 内侧 rim 光 -->
                <Ellipse Stroke="#55FFFFFF" StrokeThickness="0.9" Margin="2.8"/>
                <!-- 内核微光圈 -->
                <Ellipse Stroke="#24FFFFFF" StrokeThickness="0.7" Margin="6.5"/>
            </Grid>
        </Grid>

        <!-- ============ 展开面板（三个按钮 + 收起） ============ -->
        <!-- 球态必须整体 Collapsed：辉光底板若可见会盖住悬浮球（吃掉点击）并露出方形灰边 -->
        <Grid x:Name="PanelHost" HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed">
            <!-- 面板辉光（不参与命中测试，圆角与面板一致，避免方角露边） -->
            <Border Width="312" Height="184" CornerRadius="17" Background="#267DD3FC"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#FF7DD3FC" BlurRadius="24" ShadowDepth="0" Opacity="0.30"/>
                </Border.Effect>
            </Border>

            <Border x:Name="PanelRoot" Width="312" Height="184" CornerRadius="17"
                    BorderBrush="#3DFFFFFF" BorderThickness="1"
                    Opacity="0" IsHitTestVisible="False"
                    TextOptions.TextFormattingMode="Display">
                <Border.Effect>
                    <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                        <GradientStop Color="#F0172136" Offset="0"/>
                        <GradientStop Color="#F0222E4C" Offset="0.45"/>
                        <GradientStop Color="#EF131A30" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PanelT"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid Margin="16,9,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部行：标题 + 手动收起 -->
                        <Grid Grid.Row="0" Margin="2,0,0,7">
                            <TextBlock Text="GlassTranslate" FontSize="11" Foreground="#8FA8C8E8"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <Button x:Name="BtnCollapse" Content="✕" Width="26" Height="22"
                                    HorizontalAlignment="Right" FontSize="11" Cursor="Hand"
                                    ToolTip="收起为悬浮球">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <Button x:Name="BtnApi" Grid.Row="1" Style="{StaticResource PillButton}"
                                Content="⚙  配置 API"/>

                        <ToggleButton x:Name="TgRealtime" Grid.Row="2" Margin="0,9,0,0"
                                      Style="{StaticResource GlassToggle}"
                                      Content="启用实时全屏翻译"/>

                        <Grid Grid.Row="3" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="TgHotkey" Grid.Column="0"
                                          Style="{StaticResource GlassToggle}"
                                          Content="快捷键全屏翻译"/>
                            <Border x:Name="HkBox" Grid.Column="2" Width="98" CornerRadius="8"
                                    Background="#15FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                    Cursor="Hand" ToolTip="点击后按下想要的组合键（Esc 取消）">
                                <TextBlock x:Name="HkText" Text="Ctrl+Alt+T" FontSize="12"
                                           Foreground="#FFE5EAF2" FontFamily="Consolas"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 玻璃上缘高光 -->
                    <Border Margin="1.2" CornerRadius="16" BorderThickness="1"
                            IsHitTestVisible="False">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40FFFFFF" Offset="0"/>
                                <GradientStop Color="#06FFFFFF" Offset="0.45"/>
                                <GradientStop Color="#15FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
